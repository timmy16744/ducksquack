{
  "name": "ducksquack",
  "version": "2.0.0",
  "description": "Essays on AI, technology and society by Tim Hughes. React + Vite, with six switchable visual themes.",
  "type": "module",
  "scripts": {
    "dev": "npm run generate && vite",
    "build": "npm run generate && vite build",
    "preview": "vite preview",
    "generate": "node scripts/generate-writings.js && node scripts/generate-rss.cjs",
    "generate:writings": "node scripts/generate-writings.js",
    "generate:audio": "python scripts/generate-audio.py",
    "generate:audio:force": "python scripts/generate-audio.py --force",
    "generate:all": "node scripts/generate-writings.js && python scripts/generate-audio.py && node scripts/generate-writings.js && node scripts/generate-rss.cjs"
  },
  "keywords": [
    "blog",
    "essays",
    "portfolio",
    "react",
    "vite",
    "themes"
  ],
  "author": "Tim Hughes",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "firebase-tools": "^15.4.0",
    "vite": "^5.4.2"
  },
  "dependencies": {
    "firebase": "^12.8.0",
    "gray-matter": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
